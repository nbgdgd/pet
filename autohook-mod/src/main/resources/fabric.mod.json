{
    "schemaVersion": 1,
    "id": "autohook",
    "version": "${version}",
    "name": "AutoHook",
    "description": "Server-side auto-grapple hook mod using fishing rod mechanics. Automatically aims, casts, and pulls the player toward surfaces.",
    "authors": ["AniBlaze Team"],
    "contact": {
        "sources": "https://github.com/AniBlaze/autohook-mod"
    },
    "license": "MIT",
    "environment": "server",
    "entrypoints": {
        "main": ["com.aniblaze.autohook.AutoHookServerMod"]
    },
    "depends": {
        "fabricloader": ">=${loader_version}",
        "fabric-api": "*",
        "minecraft": ">=1.20.0 <=1.20.1"
    }
}
