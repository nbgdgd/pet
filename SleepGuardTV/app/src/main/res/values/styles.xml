<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основная тема для Android TV -->
    <style name="Theme.SleepGuardTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackground">@color/tv_background</item>
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:textColorHint">@color/tv_text_dim</item>
    </style>

    <!-- Стиль крупной кнопки для TV -->
    <style name="TVButton">
        <item name="android:layout_width">400dp</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/tv_button_text</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Стиль крупного текста для TV -->
    <style name="TVTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Стиль подзаголовка -->
    <style name="TVSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/tv_text_dim</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Стиль текста настроек -->
    <style name="SettingsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
