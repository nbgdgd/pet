<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="48dp"
        android:paddingBottom="60dp"
        android:paddingStart="80dp"
        android:paddingEnd="80dp">

        <!-- Заголовок экрана настроек -->
        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="44sp"
            android:textColor="@color/tv_text"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Статус -->
        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textColor="@color/tv_accent"
            android:text="Статус: Выключено"
            android:layout_marginBottom="36dp"
            android:gravity="center" />

        <!-- Настройка: Интервал проверки -->
        <TextView
            android:id="@+id/textInterval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textColor="@color/tv_text"
            android:text="Интервал проверки: 60 мин"
            android:layout_marginBottom="8dp" />
        <SeekBar
            android:id="@+id/seekInterval"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:max="115"
            android:progress="55"
            android:layout_marginBottom="32dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Настройка: Время ожидания -->
        <TextView
            android:id="@+id/textTimeout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textColor="@color/tv_text"
            android:text="Время ожидания: 60 сек"
            android:layout_marginBottom="8dp" />
        <SeekBar
            android:id="@+id/seekTimeout"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:max="170"
            android:progress="50"
            android:layout_marginBottom="32dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Настройка: Перемотка назад -->
        <TextView
            android:id="@+id/textRewind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textColor="@color/tv_text"
            android:text="Перемотка назад: 40 мин"
            android:layout_marginBottom="8dp" />
        <SeekBar
            android:id="@+id/seekRewind"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:max="55"
            android:progress="35"
            android:layout_marginBottom="32dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Настройка: Удержание REWIND -->
        <TextView
            android:id="@+id/textHoldDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textColor="@color/tv_text"
            android:text="Удержание REWIND: 1000 мс"
            android:layout_marginBottom="8dp" />
        <SeekBar
            android:id="@+id/seekHoldDuration"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:max="19"
            android:progress="1"
            android:layout_marginBottom="40dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Переключатель мониторинга -->
        <Switch
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_enable"
            android:textSize="26sp"
            android:textColor="@color/tv_text"
            android:layout_marginBottom="36dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:switchPadding="16dp"
            android:gravity="center_vertical" />

        <!-- Кнопка разрешений -->
        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="420dp"
            android:layout_height="72dp"
            android:text="@string/settings_permissions"
            android:textSize="26sp"
            android:textColor="@color/tv_button_text"
            android:background="@drawable/button_background"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

</ScrollView>
