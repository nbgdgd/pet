<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="60dp"
        android:paddingBottom="60dp"
        android:paddingStart="80dp"
        android:paddingEnd="80dp">

        <!-- Заголовок -->
        <TextView
            android:id="@+id/mainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textSize="52sp"
            android:textColor="@color/tv_text"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Подзаголовок -->
        <TextView
            android:id="@+id/mainSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_subtitle"
            android:textSize="24sp"
            android:textColor="@color/tv_text_dim"
            android:gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- Статус -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textColor="@color/tv_accent"
            android:text="@string/status_inactive"
            android:layout_marginBottom="48dp"
            android:gravity="center" />

        <!-- Кнопка запуска -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="420dp"
            android:layout_height="72dp"
            android:text="@string/btn_start"
            android:textSize="28sp"
            android:textColor="@color/tv_button_text"
            android:background="@drawable/button_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="20dp"
            android:nextFocusDown="@+id/btnStop" />

        <!-- Кнопка остановки -->
        <Button
            android:id="@+id/btnStop"
            android:layout_width="420dp"
            android:layout_height="72dp"
            android:text="@string/btn_stop"
            android:textSize="28sp"
            android:textColor="@color/tv_button_text"
            android:background="@drawable/button_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="20dp"
            android:nextFocusUp="@+id/btnStart"
            android:nextFocusDown="@+id/btnSettings" />

        <!-- Кнопка настроек -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="420dp"
            android:layout_height="72dp"
            android:text="@string/btn_settings"
            android:textSize="28sp"
            android:textColor="@color/tv_button_text"
            android:background="@drawable/button_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@+id/btnStop" />

    </LinearLayout>

</ScrollView>
